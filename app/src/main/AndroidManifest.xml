<?xml version="1.0" encoding="UTF-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:name=".App"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FyCore">

        <activity
            android:name=".function.read.ReadBookActivity"
            android:exported="false" />

        <activity
            android:name=".function.TTSActivity"
            android:exported="false" />

        <activity
            android:name=".function.ClickTextActivity"
            android:exported="false" />

        <activity
            android:name=".function.ImgTextActivity"
            android:exported="false" />

        <activity
            android:name=".function.CollapsingBarActivity"
            android:exported="false" />

        <activity
            android:name=".function.EventActivity"
            android:exported="false" />

        <activity
            android:name=".function.VisibilityActivity"
            android:exported="false" />

        <activity
            android:name=".function.CustomToastActivity"
            android:exported="false" />

        <activity
            android:name=".function.DialogActivity"
            android:exported="false" />

        <activity
            android:name=".function.RoomActivity"
            android:exported="false" />

        <activity
            android:name=".function.KeyboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".function.TestPageActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".function.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FyCore.Splash">

            <intent-filter>

                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

            <meta-data
                android:name="android.app.lib_name"
                android:value="" />

        </activity>

        <service
            android:name=".function.read.services.TTSReadAloudService"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name=".function.read.services.AudioPlayService"
            android:foregroundServiceType="mediaPlayback" />

    </application>


</manifest>
