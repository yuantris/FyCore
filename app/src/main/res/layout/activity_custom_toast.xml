<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.core.libraries.view.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleLeftAlign="true"
        app:titleSize="@dimen/sp_16"
        app:titleText="自定义Toast" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/show_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="show_top" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/show_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="show_center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/show_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="show_bottom" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="cancel" />
</LinearLayout>