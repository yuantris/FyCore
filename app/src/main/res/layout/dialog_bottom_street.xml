<?xml version="1.0" encoding="utf-8"?>
<io.core.widget.layout.ShapeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dp_8"
    app:shape_radius="@dimen/dp_16"
    app:shape_solidColor="@color/md_indigo_100">

    <!-- 选项1按钮 -->
    <io.core.widget.view.SettingBar
        android:id="@+id/buttonOption1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:bar_leftText="选项1" />

    <!-- 选项2按钮 -->
    <io.core.widget.view.SettingBar
        android:id="@+id/buttonOption2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/common_accent_color"
        app:bar_leftText="选项2" />

    <!-- 取消按钮 -->
    <io.core.widget.view.SettingBar
        android:id="@+id/buttonCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/common_accent_color"
        app:bar_leftText="取消" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

</io.core.widget.layout.ShapeLinearLayout>