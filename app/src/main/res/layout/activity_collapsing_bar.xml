<?xml version="1.0" encoding="utf-8"?>
<com.core.libraries.widget.layout.CollapsingHeaderLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:headerImageSrc="@drawable/start"
    app:headerTitle="Dynamic Title"
    app:scrimColor="@color/white">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pink">

        <ImageView
            android:id="@+id/iv_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_launcher_round"/>
    </androidx.core.widget.NestedScrollView>
</com.core.libraries.widget.layout.CollapsingHeaderLayout>