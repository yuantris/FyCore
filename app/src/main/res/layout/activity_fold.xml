<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent">

    <io.core.widget.layout.TitleBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- 使用自定义的SmoothStickyNestedScrollView -->
    <com.core.fy.android.function.fold.SmoothStickyNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶部空间，用于确保吸顶View初始位置在中间 -->
            <View
                android:layout_width="match_parent"
                android:background="@color/md_yellow_A100"
                android:layout_height="200dp"/>

            <!-- 吸顶View容器 -->
            <FrameLayout
                android:id="@+id/sticky_header_container"
                android:layout_width="match_parent"
                android:background="@color/md_yellow_700"
                android:layout_height="wrap_content">

                <!-- 展开状态的View -->
                <LinearLayout
                    android:id="@+id/expanded_view"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="#FF5722"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="展开状态标题"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="这里是详细描述信息"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- 折叠状态的View -->
                <LinearLayout
                    android:id="@+id/collapsed_view"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="#D32F2F"
                    android:gravity="center"
                    android:alpha="0">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="折叠状态"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"/>
                </LinearLayout>
            </FrameLayout>

            <!-- 其他内容 -->
            <View
                android:layout_width="match_parent"
                android:background="@color/colorAccent"
                android:layout_height="1000dp"/>
        </LinearLayout>
    </com.core.fy.android.function.fold.SmoothStickyNestedScrollView>

</LinearLayout>
